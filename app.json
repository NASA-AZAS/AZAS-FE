{
  "expo": {
    "name": "LAMP",
    "slug": "azas-app",
    "version": "1.0.0",
    "orientation": "landscape",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#03070d",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true
    },
    "android": {
      "package": "com.azas.orbit"
    },
    "plugins": [
      "expo-router",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "LANDSCAPE"
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#03070d",
          "image": "./assets/rocket-neon-dark.png",
          "imageWidth": 360,
          "resizeMode": "contain"
        }
      ],
      "expo-video"
    ],
    "web": {
      "bundler": "metro",
      "name": "LAMP · Lunar Access & Mission Planning",
      "output": "single"
    },
    "scheme": "azas"
  }
}
